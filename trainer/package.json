{
  "name": "chesslab-trainer",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3021",
    "build": "next build",
    "start": "next start -p 3020",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "content": "scripts/content.sh",
    "narrate": "tsx scripts/narrate.ts",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "tsx --conditions=react-server --env-file=.env.development.local scripts/migrate.ts",
    "db:migrate:prod": "tsx --conditions=react-server --env-file=.env.production.local scripts/migrate.ts",
    "env:dev": "tsx scripts/env.ts dev",
    "env:prod": "tsx scripts/env.ts prod",
    "deploy:prod": "scripts/deploy.sh"
  },
  "dependencies": {
    "better-auth": "^1.7.14",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "ts-fsrs": "5.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
