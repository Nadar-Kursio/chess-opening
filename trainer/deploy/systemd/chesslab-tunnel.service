[Unit]
Description=ChessLab trainer: Cloudflare tunnel (new.chesslab.dev)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/bin/cloudflared tunnel --config /home/ec2-user/.cloudflared/chesslab.yml run chesslab
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
