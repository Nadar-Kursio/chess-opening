[Unit]
Description=ChessLab trainer: production server (next start, port 3020, shared Kursio RDS)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/ec2-user/chess-opening/trainer
Environment=PATH=/home/ec2-user/.nvm/versions/node/v24.15.0/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=/home/ec2-user/.nvm/versions/node/v24.15.0/bin/node node_modules/next/dist/bin/next start -p 3020
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
